{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qfoldit/GLAM/blob/main/integrations/qfoldit_glam/run-result.schema.json",
  "title": "qFoldIT GLAM reproducible computation result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "run_id", "adapter", "engine", "mission", "task",
    "dataset", "parameters", "artifacts", "completed_at",
    "scientific_validation_status", "evidence_status"
  ],
  "properties": {
    "contract": {"const": "qfoldit.glam.run-result/1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "qfoldit.glam"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": ["name", "source_commit", "python_version", "torch_version", "torch_geometric_version", "rdkit_version"],
      "properties": {
        "name": {"const": "GLAM"},
        "source_commit": {"type": ["string", "null"]},
        "python_version": {"type": "string"},
        "torch_version": {"type": ["string", "null"]},
        "torch_geometric_version": {"type": ["string", "null"]},
        "rdkit_version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "required": ["mission_id", "mission_version", "submission_id", "action_envelope_hash", "tenant_id"],
      "properties": {
        "mission_id": {"type": "string"},
        "mission_version": {"type": "string"},
        "submission_id": {"type": "string", "format": "uuid"},
        "action_envelope_hash": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "tenant_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "task": {"const": "adaptive-property-search"},
    "dataset": {
      "type": "object",
      "required": ["id", "revision", "sha256", "split", "split_seed"],
      "properties": {
        "id": {"type": "string"},
        "revision": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "split": {"enum": ["scaffold", "random"]},
        "split_seed": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "parameters": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "completed_at": {"type": "string", "format": "date-time"},
    "scientific_validation_status": {"const": "NOT_PERFORMED"},
    "evidence_status": {"const": "NOT_CREATED"}
  }
}