{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qfoldit/GLAM/blob/main/integrations/qfoldit_glam/job-response.schema.json",
  "title": "qFoldIT GLAM adapter job response 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "contract",
    "task",
    "mission_id",
    "mission_version",
    "submission_id",
    "action_envelope_hash",
    "dataset",
    "dataset_revision",
    "dataset_sha256",
    "split",
    "parameters",
    "status",
    "created_at",
    "started_at",
    "completed_at",
    "exit_code",
    "error",
    "artifact_status",
    "artifact_count",
    "run_manifest_sha256",
    "scientific_validation_status",
    "evidence_status"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "contract": {
      "const": "qfoldit.glam-adapter.job-response/0.2"
    },
    "task": {
      "const": "adaptive-property-search"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_version": {
      "type": "string",
      "minLength": 1
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_envelope_hash": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "dataset_revision": {
      "type": "string",
      "minLength": 1
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "split": {
      "enum": [
        "scaffold",
        "random"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "INTERRUPTED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_status": {
      "enum": [
        "PENDING",
        "CREATED",
        "NOT_CREATED",
        "UNKNOWN"
      ]
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "run_manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "scientific_validation_status": {
      "const": "NOT_PERFORMED"
    },
    "evidence_status": {
      "const": "NOT_CREATED"
    },
    "log_tail": {
      "type": "string",
      "maxLength": 8000
    }
  }
}
